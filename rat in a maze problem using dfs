class Solution {
  public:
    void solve(int row, int col, vector<vector<int>>& maze, vector<vector<int>> &visited,
            vector<string> &ans, string path, int n){

        //base case
        if(row == n-1 && col == n-1){
            //destination reached 
            ans.push_back(path);
            return;
        }
        
        visited[row][col] = 1;
        
        //check all 4 directions //DLRU
            int delRow[] = {1, 0, 0, -1};
            int delCol[] = {0, -1, 1, 0};
            char dir[] = {'D', 'L', 'R', 'U'};
        
        for(int i=0; i<4; i++){
            
            int newRow = row + delRow[i];
            int newCol = col + delCol[i];
            
            if(newRow >= 0 && newRow < n && newCol >= 0 && newCol < n && 
               maze[newRow][newCol] == 1 && !visited[newRow][newCol]){
                 
                     solve(newRow, newCol, maze, visited, ans, path + dir[i], n);
            }
            
        }
        
        //backTrack
        visited[row][col] = 0;
    }
    
    vector<string> ratInMaze(vector<vector<int>>& maze) {
        // code here
        int n = maze.size();
        vector<string> ans;
        
        if(maze[0][0] == 0)
        return ans;
        
        vector<vector<int>> visited(n, vector<int> (n, 0));
        
        solve(0, 0, maze, visited, ans, "", n);
        
        return ans;
       
    }
};

class Solution {
  public:
    int minPlatform(vector<int>& arr, vector<int>& dep) {
        
        int n = arr.size();
        
        sort(arr.begin(), arr.end());
        sort(dep.begin(), dep.end());
        int i = 0, j = 0;
        
        int maxCnt = 0, cnt = 0;
        
        while( i < n){
            if(arr[i] <= dep[j]){
                cnt = cnt + 1;
                i = i+1;
            }else{
                cnt = cnt - 1;
                j = j + 1;
            }
            maxCnt = max(maxCnt, cnt);
        }
        return maxCnt;
        
    }
};

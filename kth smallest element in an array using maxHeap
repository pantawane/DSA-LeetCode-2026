class Solution {
  public:
    int kthSmallest(vector<int> &arr, int k) {
        //create a max heap
        priority_queue<int> pq;
        
        //step 1 first k elements
        for(int i=0; i<k; i++){
            pq.push(arr[i]);
        }
        
        //step 2 for rest of k to n-1
        for(int i = k; i< arr.size(); i++){
            if(arr[i] < pq.top()){
                pq.pop();
                pq.push(arr[i]);
            }
        }
        
        //ans = pq.top
       int ans = pq.top();
        return ans;
        
    }
};

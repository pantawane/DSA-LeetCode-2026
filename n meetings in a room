class Data{
  public:
    
    int start;
    int end;
    int pos;
};

bool comp(Data a, Data b){
    if(a.end == b.end){
        return a.pos < b.pos;
    }

    return a.end < b.end;
}


class Solution {
  public:
    vector<int> maxMeetings(vector<int> &s, vector<int> &f) {
        
        int n = s.size();
        if(n == 0) return {};
        
        vector<Data> arr(n);
        
        for(int i=0; i<n; i++){
            arr[i].start = s[i];
            arr[i].end = f[i];
            arr[i].pos = i+1;
        }
        
        sort(arr.begin(), arr.end(), comp);
        
        int cnt = 1; int freeTime = arr[0].end;
        vector<int> ds;
        ds.push_back(arr[0].pos);
        
        for(int i = 1; i<n; i++){
            if(arr[i].start > freeTime){
                cnt += 1;
                freeTime = arr[i].end;
                ds.push_back(arr[i].pos);
            }
        }
        sort(ds.begin(), ds.end());
        return ds;
        
    }
};
